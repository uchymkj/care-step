<h1>社員詳細</h1>

<% latest_procedure = @employee.latest_procedure %>

<p>
  <strong>氏名：</strong>
  <%= @employee.name %>
</p>

<p>
  <strong>所属：</strong>
  <%= @employee.department.name %>
</p>

<p>
  <strong>出産予定日：</strong>
  <%= @employee.expected_delivery_date || "未登録" %>
</p>

<p>
  <strong>出産日：</strong>
  <%= @employee.delivery_date || "未登録" %>
</p>

<p>
  <strong>産前産後休業期間：</strong>
  <%= @employee.maternity_leave_start_date || "未登録" %>
  ～
  <%= @employee.maternity_leave_end_date || "未登録" %>
</p>

<p>
  <strong>育児休業期間：</strong>
  <%= @employee.childcare_leave_start_date || "未登録" %>
  ～
  <%= @employee.childcare_leave_end_date || "未登録" %>
</p>

<p>
  <strong>最新の手続き：</strong>
  <%= latest_procedure&.procedure_type&.name || "未登録" %>
</p>

<p>
  <strong>進捗：</strong>
  <%= latest_procedure&.status_label || "未登録" %>
</p>

<div>
  <%= link_to "更新", edit_employee_path(@employee) %>
  <%= link_to "手続一覧・進捗更新", employee_employee_procedures_path(@employee) %>
  <%= button_to "削除", employee_path(@employee), method: :delete, data: { turbo_confirm: "本当に削除しますか？" } %>
  <%= link_to "ダッシュボード", dashboard_path %>
</div>
