<h1>手続一覧・進捗更新</h1>

<p>
  <strong>氏名：</strong>
  <%= @employee.name %>
</p>

<table>
  <thead>
    <tr>
      <th>手続名</th>
      <th>期限</th>
      <th>進捗</th>
      <th>備考</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    <% @employee_procedures.each do |employee_procedure| %>
      <tr>
        <td colspan="5">
          <%= form_with model: [@employee, employee_procedure] do |form| %>
            <%= employee_procedure.procedure_type.name %>

            <%= form.date_field :deadline %>

            <%= form.select :status, [
              ["未着手", "not_started"],
              ["対応中", "in_progress"],
              ["完了", "completed"]
            ] %>

            <%= form.text_field :notes %>

            <%= form.submit "登録・更新" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "社員詳細へ戻る", employee_path(@employee) %>
